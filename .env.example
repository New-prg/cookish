# Web OAuth client. Used only by the browser version.
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-example
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Random string with at least 32 characters.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional legacy integrations.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_RANGE=Events!A:Z
GOOGLE_FORM_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EVENT_WEBHOOK_SECRET=
